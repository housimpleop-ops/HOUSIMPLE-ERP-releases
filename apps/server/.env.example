# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# 기본 claude-opus-5. 비용 아끼려면 claude-sonnet-5
CLAUDE_MODEL=claude-opus-5

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=AIza...

# (선택) 앱에서만 호출하도록 막는 공유 비밀키. 앱의 EXPO_PUBLIC_APP_KEY 와 같게
APP_API_KEY=

PORT=8787
DATA_DIR=./data

# (선택) 네이버 블로그 검색 — https://developers.naver.com/apps 에서 앱 등록 후 발급
# 검색 API는 파싱이 아니라 정식 API라 차단 위험이 없다. 없으면 네이버 검색만 건너뛴다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
